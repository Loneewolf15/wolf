{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Wolf",
    "scopeName": "source.wolf",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.wolf",
                    "match": "//.*$"
                },
                {
                    "name": "comment.line.number-sign.wolf",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.wolf",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.wolf",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.wolf",
                            "match": "\\\\."
                        },
                        {
                            "include": "#interpolation"
                        }
                    ]
                }
            ]
        },
        "interpolation": {
            "patterns": [
                {
                    "name": "meta.embedded.line.wolf",
                    "begin": "\\$\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": { "name": "punctuation.section.embedded.begin.wolf" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.section.embedded.end.wolf" }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                },
                {
                    "name": "meta.embedded.line.wolf",
                    "begin": "\\{\\$",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": { "name": "punctuation.section.embedded.begin.wolf" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.section.embedded.end.wolf" }
                    },
                    "patterns": [
                        {
                            "name": "variable.other.readwrite.wolf",
                            "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.wolf",
                    "match": "\\b(if|else|for|foreach|while|match|return|try|catch|async|await|spawn|parallel|channel|send|receive)\\b"
                },
                {
                    "name": "keyword.other.wolf",
                    "match": "\\b(import|namespace|as|in|print|new)\\b"
                },
                {
                    "name": "storage.type.wolf",
                    "match": "\\b(func|howl|function|class|enum|interface|implements|var)\\b"
                },
                {
                    "name": "storage.modifier.wolf",
                    "match": "\\b(private|pri|public|pub|protected|pro|static)\\b"
                },
                {
                    "name": "constant.language.wolf",
                    "match": "\\b(true|false|nil|error)\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.readwrite.wolf",
                    "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.wolf",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.control.directive.wolf",
                    "match": "@(ml|supervise|trace)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.wolf",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.wolf",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.wolf",
                    "match": "(\\+|-|\\*|/|%|==|!=|<|<=|>|>=|&&|\\|\\||!|=|\\+=|-=|\\*=|/=|->|=>|\\.|\\.\\.|\\?|::)"
                }
            ]
        }
    }
}
