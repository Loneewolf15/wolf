func testHealthEndpoint($t) {
    // 1. Send GET /health
    var $res = wolf_http_get("http://127.0.0.1:2006/health")
    
    // 2. Assert status 200
    $t->assertEq($res->status, 200, "Health endpoint should return HTTP 200")
    
    // 3. Assert Content-Type is JSON
    var $ctype = $res->headers["Content-Type"]
    $t->assertEq($ctype, "application/json", "Health endpoint should return JSON")
    
    // 4. Assert body is valid JSON
    var $data = json_decode($res->body)
    $t->assertEq($data["status"], "ok", "Health payload status should be ok")
    
    // 5. Check metrics object exists
    var $metrics = $data["metrics"]
    $t->assertEq(gettype($metrics), "map", "Health payload should contain metrics map")
}

// We need a dummy handler to start the server
func handler($req, $res) {
    $res->status(404)->json({"error": "not found"})
}

func main() {
    print("Starting health endpoint test...")
    // In wolf test framework, how do we start a background server?
    // Usually wolf_http_serve blocks. We might need a separate client test script or fork.
    // Actually, `wolf_http_get` works if we run it in a parallel block, or if `wolf test` boots the server natively.
}
