# Test: Method Chaining (Fluent Interface Pattern)
# Uses explicit intval to work around arithmetic type inference in chained context.

class Adder {
    public $sum = 0

    public func add($n: int) {
        $this->sum = intval($this->sum) + intval($n)
        return $this
    }

    public func result() {
        return $this->sum
    }
}

$a = new Adder()
$a->add(10)->add(20)->add(12)
print($a->result())
print("Method chain executed")
