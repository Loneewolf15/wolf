# wolf.config — API project
# Generated by wolf new --type=api

[target]
mode = api        # full HTTP server, Thread-Per-Core, arena pool
arch = native     # compile for the host machine

[app]
name    = project_test
version = 1.0.0
env     = development

[server]
host    = 0.0.0.0
port    = 2006
workers = 0       # 0 = auto-detect CPU count at startup

[database]
driver   = mysql
host     = localhost
port     = 3306
name     = project_test_db
user     = root
password =
pool_size = 10

[redis]
host = 127.0.0.1
port = 6379
