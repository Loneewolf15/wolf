// T1-03: Class Instantiation + Method Call
// Proves OOP correctness: instantiation, property mutation, method dispatch.

class Counter {
    $count: int

    func __construct() {
        $this->count = 0
    }

    func increment() {
        $this->count = $this->count + 1
    }

    func decrement() {
        $this->count = $this->count - 1
    }

    func reset() {
        $this->count = 0
    }

    func value() -> int {
        return $this->count
    }
}

class BoundedCounter {
    $count: int
    $max: int

    func __construct($max: int) {
        $this->count = 0
        $this->max = $max
    }

    func increment() {
        $next = $this->count + 1
        if ($next <= $this->max) {
            $this->count = $next
        }
    }

    func value() -> int {
        return $this->count
    }
}

class NamedEntity {
    $name: string
    $id: int

    func __construct($id: int, $name: string) {
        $this->id = $id
        $this->name = $name
    }

    func label() -> string {
        $n = $this->name
        $i = $this->id
        return "{$n}#{$i}"
    }
}

func test_counter_basic() {
    $c = new Counter()
    $c->increment()
    $c->increment()
    $val = $c->value()
    if ($val != 2) {
        error("T1-03: Counter after 2 increments expected 2, got: {$val}")
    }
}

func test_counter_triple_increment() {
    $c = new Counter()
    $c->increment()
    $c->increment()
    $c->increment()
    $val = $c->value()
    if ($val != 3) {
        error("T1-03: Counter after 3 increments expected 3, got: {$val}")
    }
}

func test_counter_decrement() {
    $c = new Counter()
    $c->increment()
    $c->increment()
    $c->increment()
    $c->decrement()
    $val = $c->value()
    if ($val != 2) {
        error("T1-03: Counter after 3 increments + 1 decrement expected 2, got: {$val}")
    }
}

func test_counter_reset() {
    $c = new Counter()
    $c->increment()
    $c->increment()
    $c->reset()
    $val = $c->value()
    if ($val != 0) {
        error("T1-03: Counter after reset expected 0, got: {$val}")
    }
}

func test_counter_independence() {
    // Two counters must be independent — no shared state
    $c1 = new Counter()
    $c2 = new Counter()
    $c1->increment()
    $c1->increment()
    $c2->increment()
    $v1 = $c1->value()
    $v2 = $c2->value()
    if ($v1 != 2) {
        error("T1-03: c1 expected 2, got: {$v1}")
    }
    if ($v2 != 1) {
        error("T1-03: c2 expected 1, got: {$v2}")
    }
}

func test_bounded_counter() {
    $bc = new BoundedCounter(3)
    $bc->increment()
    $bc->increment()
    $bc->increment()
    $bc->increment() // should be clamped
    $bc->increment() // should be clamped
    $val = $bc->value()
    if ($val != 3) {
        error("T1-03: BoundedCounter(3) after 5 increments expected 3, got: {$val}")
    }
}

func test_named_entity() {
    $e = new NamedEntity(42, "Wolf")
    $label = $e->label()
    if ($label != "Wolf#42") {
        error("T1-03: NamedEntity label expected 'Wolf#42', got: {$label}")
    }
}


// WOLF TEST RUNNER
test_counter_basic()
test_counter_triple_increment()
test_counter_decrement()
test_counter_reset()
test_counter_independence()
test_bounded_counter()
test_named_entity()
print("ALL TESTS PASSED IN t1_classes_test.wolf")
