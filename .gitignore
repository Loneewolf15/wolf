# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/wolf
wolf_out/
test-venv/
.default-venv/
__pycache__/

# Output and build directories
bin/
obj/

# Ignored Folders
Agskills/
BackendTemplate/

# Build artifacts — never commit compiled objects
*.o
coverage.out
*.out.tmp

# Runtime C objects (clang emits these during wolf build)
runtime/*.o
runtime/*.a

# Bench compiled binaries (Go/Node runners)
bench/*_go
bench/load_tester
bench/real_go
bench/echo_go
bench/*.err
bench/wolf_server.err

# E2E runtime logs (generated by test harness, not source)
e2e/server_*.log

# Benchmark result captures (stored in .wolf-vault, not git)
benchmarks/*.txt

# macOS / editor noise
.DS_Store
*.swp
*.swo
