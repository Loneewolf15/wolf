func handler($req_id, $res_id) {
    // 1. CPU / Math Activity
    $result = fib(20)

    // 2. Python Interop (ML Bridge)
    @ml {
        import math
        x = math.sqrt(144)
    }

    // 3. Database Activity (Redis)
    $redis = redis_connect("127.0.0.1", 6379, "")
    $db_status = "offline"
    redis_set($redis, "wolf_bench_key", "alive")
    $val = redis_get($redis, "wolf_bench_key")
    if ($val == "alive") {
        $db_status = "online"
    }
    redis_close($redis)

    wolf_http_res_status($res_id, 200)
    wolf_http_res_write($res_id, "Wolf Comprehensive OK! Fib(20)=" .. $result .. " DB=" .. $db_status)
}

func fib($n) {
    if ($n <= 1) { return $n }
    return fib($n - 1) + fib($n - 2)
}

println("Starting Wolf Comprehensive Server on 8086...")
wolf_http_serve(8086, handler)
