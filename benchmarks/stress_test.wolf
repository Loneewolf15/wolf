

func test_stack($n) {
    if ($n <= 0) {
        return 0
    }
    return test_stack($n - 1)
}

func slow_task() {
    wolf_system_sleep(1000)
}

println("=== WOLF EXTREME STRESS TEST ===")

// 1. Stack Buster
println("1. Running Stack Buster (Depth: 50,000)...")
// This should gracefully panic rather than segfaulting the OS process if the limit is reached.
$res = test_stack(50000)
println("Stack Buster survived. Result: " .. $res)

// 2. Interop Avalanche
println("2. Running Interop Avalanche (100 ML calls)...")
$start = time_ms()
for $i = 0; $i < 100; $i = $i + 1 {
    @ml {
        x = 1 + 1
    }
}
$end = time_ms()
println("Interop Avalanche survived in " .. ($end - $start) .. "ms")

// 3. Thread Exhaustion
println("3. Running Thread Exhaustion (2,000 spawn tasks)...")
for $i = 0; $i < 2000; $i = $i + 1 {
    spawn slow_task()
}
println("Spawn loop finished. Waiting for tasks to complete...")
// We'll just exit here to see if the engine handles shutdown with pending tasks gracefully.
println("Stress Test Complete!")
