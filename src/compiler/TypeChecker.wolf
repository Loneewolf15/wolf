// TypeChecker.wolf
// Implements the Wolf native type checking phase.
// In default mode, performs minimal boundary checks.
// In strict mode, validates annotations and @ml boundaries.

class TypeChecker {
    public $resolver = nil
    public $errors = []
    public $strictMode = false
    public $file = ""
    public $dbConfigKeys = {}

    public func __construct($resolver, $file) {
        $this->resolver = $resolver
        $this->file = $file
        $this->errors = []
        $this->strictMode = false
        
        // Initialize known DB config keys
        $this->dbConfigKeys = {}
        // $this->dbConfigKeys["DB_HOST"] = true
        // $this->dbConfigKeys["DB_USER"] = true
        // $this->dbConfigKeys["DB_PASS"] = true
        // $this->dbConfigKeys["DB_NAME"] = true
        // $this->dbConfigKeys["DB_PORT"] = true
        // $this->dbConfigKeys["REDIS_HOST"] = true
        // $this->dbConfigKeys["REDIS_PORT"] = true
        // $this->dbConfigKeys["REDIS_PASS"] = true
        // $this->dbConfigKeys["MONGO_HOST"] = true
        // $this->dbConfigKeys["MONGO_PORT"] = true
        // $this->dbConfigKeys["MONGO_DB"] = true
    }

    public func SetStrictMode($strict) {
        $this->strictMode = $strict
        return nil
    }

    public func Check($program) {
        if ($program == nil) { return $this->errors }
        var $stmts = $program->statements
        var $i = 0
        var $len = count($stmts)
        while ($i < $len) {
            $this->checkStmt($stmts[$i])
            $i = intval($i) + 1
        }
        return $this->errors
    }

    public func Errors() {
        return $this->errors
    }

    public func addError($line, $col, $msg) {
        var $e = {}
        $e["level"] = "error"
        $e["line"] = $line
        $e["col"] = $col
        $e["message"] = $msg
        $e["phase"] = "typechecker"
        Arrays::array_push($this->errors, $e)

        var $l1 = "TYPE ERROR: " .. $msg
        var $l2 = $l1 .. " at line "
        var $l3 = $l2 .. $line
        print($l3)
        return nil
    }

    public func addWarning($line, $col, $msg) {
        var $e = {}
        $e["level"] = "warning"
        $e["line"] = $line
        $e["col"] = $col
        $e["message"] = $msg
        $e["phase"] = "typechecker"
        Arrays::array_push($this->errors, $e)

        var $l1 = "TYPE WARNING: " .. $msg
        var $l2 = $l1 .. " at line "
        var $l3 = $l2 .. $line
        return nil
    }

    // ========== Statement Checking ==========

    public func checkStmt($stmt) {
        if ($stmt == nil) { return nil }
        var $t = $stmt->type

        if ($t == "VarDecl")       { return $this->checkVarDecl($stmt) }
        if ($t == "FuncDecl")      { return $this->checkFuncDecl($stmt) }
        if ($t == "EnumDecl")      { return $this->checkEnumDecl($stmt) }
        if ($t == "ClassDecl")     { return $this->checkClassDecl($stmt) }
        if ($t == "ReturnStmt")    { return $this->checkReturnStmt($stmt) }
        if ($t == "IfStmt")        { return $this->checkIfStmt($stmt) }
        if ($t == "ForStmt")       { return $this->checkForStmt($stmt) }
        if ($t == "ForeachStmt")   { return $this->checkForeachStmt($stmt) }
        if ($t == "WhileStmt")     { return $this->checkWhileStmt($stmt) }
        if ($t == "MatchStmt")     { return $this->checkMatchStmt($stmt) }
        if ($t == "TryCatchStmt")  { return $this->checkTryCatchStmt($stmt) }
        if ($t == "MLBlockStmt")   { return $this->checkMLBlock($stmt) }
        if ($t == "ParallelStmt")  { return $this->checkBlock($stmt->body) }
        if ($t == "SuperviseBlockStmt") { return $this->checkBlock($stmt->body) }
        if ($t == "TraceBlockStmt"){ 
            $this->checkExpr($stmt->spanName)
            return $this->checkBlock($stmt->body) 
        }
        if ($t == "DestructureAssign") { return $this->checkExpr($stmt->value) }
        if ($t == "ExpressionStmt"){ return $this->checkExpr($stmt->expr) }
        if ($t == "AssignStmt")    { 
            $this->checkExpr($stmt->target)
            return $this->checkExpr($stmt->value)
        }
        if ($t == "BlockStmt")     { return $this->checkBlock($stmt) }

        return nil
    }

    public func checkBlock($block) {
        if ($block == nil) { return nil }
        if ($block->type != "BlockStmt") { return nil }
        var $stmts = $block->statements
        var $i = 0
        var $len = count($stmts)
        while ($i < $len) {
            $this->checkStmt($stmts[$i])
            $i = intval($i) + 1
        }
        return nil
    }

    public func checkReturnStmt($stmt) {
        var $i = 0
        var $len = count($stmt->values)
        while ($i < $len) {
            $this->checkExpr($stmt->values[$i])
            $i = intval($i) + 1
        }
        return nil
    }

    public func checkIfStmt($stmt) {
        $this->checkExpr($stmt->condition)
        $this->checkBlock($stmt->body)
        var $i = 0
        var $len = count($stmt->elseIfs)
        while ($i < $len) {
            var $eif = $stmt->elseIfs[$i]
            $this->checkExpr($eif->condition)
            $this->checkBlock($eif->body)
            $i = intval($i) + 1
        }
        if ($stmt->elseBody != nil) {
            $this->checkBlock($stmt->elseBody)
        }
        return nil
    }

    public func checkWhileStmt($stmt) {
        $this->checkExpr($stmt->condition)
        $this->checkBlock($stmt->body)
        $this->checkN1InLoop($stmt->body, $stmt->line)
        return nil
    }

    public func checkForStmt($stmt) {
        $this->checkStmt($stmt->init)
        $this->checkExpr($stmt->condition)
        $this->checkStmt($stmt->update)
        $this->checkBlock($stmt->body)
        $this->checkN1InLoop($stmt->body, $stmt->line)
        return nil
    }

    public func checkForeachStmt($stmt) {
        $this->checkExpr($stmt->iterable)
        $this->checkBlock($stmt->body)
        $this->checkN1InLoop($stmt->body, $stmt->line)
        return nil
    }

    public func checkMatchStmt($stmt) {
        $this->checkExpr($stmt->subject)
        var $i = 0
        var $len = count($stmt->arms)
        var $hasWildcard = false

        while ($i < $len) {
            var $arm = $stmt->arms[$i]
            if ($arm->pattern->type == "Wildcard") {
                $hasWildcard = true
            } else {
                $this->checkExpr($arm->pattern)
            }
            
            var $j = 0
            var $blen = count($arm->body)
            while ($j < $blen) {
                $this->checkStmt($arm->body[$j])
                $j = intval($j) + 1
            }
            $i = intval($i) + 1
        }

        if ($this->strictMode) {
            // TODO: In the future, verify Enum/Boolean variants explicitly. 
            // If all variants are covered, a wildcard should not be required.
            if (!$hasWildcard) {
                $this->addError($stmt->line, $stmt->col, "non-exhaustive match statement: missing wildcard '_' fallback")
            }
        }

        return nil
    }

    public func checkTryCatchStmt($stmt) {
        $this->checkBlock($stmt->tryBody)
        $this->checkBlock($stmt->catchBody)
        return nil
    }

    // ========== Declarations ==========

    public func checkVarDecl($v) {
        if ($v->value != nil) {
            $this->checkExpr($v->value)
        }

        if ($this->strictMode) {
            if ($v->typeName != "") {
                if ($v->value != nil) {
                    var $declaredType = $this->stringToType($v->typeName)
                    var $inferredType = $this->inferType($v->value)
                    
                    if ($declaredType != "unknown") {
                        if ($inferredType != "any") {
                            if ($inferredType != "unknown") {
                                if ($declaredType != $inferredType) {
                                    var $m1 = "type mismatch: variable '" .. $v->name
                                    var $m2 = $m1 .. "' declared as '"
                                    var $m3 = $m2 .. $declaredType
                                    var $m4 = $m3 .. "' but assigned '"
                                    var $m5 = $m4 .. $inferredType
                                    var $m6 = $m5 .. "'"
                                    $this->addError($v->line, $v->col, $m6)
                                }
                            }
                        }
                    }
                }
            }
        }
        return nil
    }

    public func checkEnumDecl($e) {
        return nil
    }

    public func checkFuncDecl($f) {
        var $i = 0
        var $len = count($f->params)
        while ($i < $len) {
            var $param = $f->params[$i]
            if ($param->defaultVal != nil) {
                $this->checkExpr($param->defaultVal)
            }
            $i = intval($i) + 1
        }
        if ($f->body != nil) {
            $this->checkBlock($f->body)
        }
        if ($f->arrowExpr != nil) {
            $this->checkExpr($f->arrowExpr)
        }
        return nil
    }

    public func checkClassDecl($cls) {
        var $i = 0
        var $len = count($cls->properties)
        while ($i < $len) {
            var $prop = $cls->properties[$i]
            if ($prop->defaultVal != nil) {
                $this->checkExpr($prop->defaultVal)
            }
            $i = intval($i) + 1
        }
        
        $i = 0
        $len = count($cls->methods)
        while ($i < $len) {
            $this->checkFuncDecl($cls->methods[$i])
            $i = intval($i) + 1
        }
        return nil
    }

    public func checkMLBlock($ml) {
        // Strict mode ML boundary checks: verify inVars are resolved
        if ($this->strictMode) {
            if ($this->resolver != nil) {
                // Wait, resolver in Wolf needs a way to query resolved names?
                // The Go version does: resolvedNames := c.resolver.ResolvedNames()
                // In Wolf, resolver resolves names inline, but the ML check happens here.
                // We'll skip deep resolver checking for now and just check modelName
            }
        }
        if ($ml->modelName != nil) {
            $this->checkExpr($ml->modelName)
        }
        return nil
    }

    // ========== Expressions ==========

    public func checkExpr($expr) {
        if ($expr == nil) { return nil }
        var $t = $expr->type

        if ($t == "BinaryExpr") {
            $this->checkExpr($expr->left)
            return $this->checkExpr($expr->right)
        }
        if ($t == "UnaryExpr") {
            return $this->checkExpr($expr->operand)
        }
        if ($t == "PostfixExpr") {
            return $this->checkExpr($expr->operand)
        }
        if ($t == "CallExpr") {
            $this->checkExpr($expr->callee)
            var $i = 0
            var $len = count($expr->args)
            while ($i < $len) {
                $this->checkExpr($expr->args[$i])
                $i = intval($i) + 1
            }
            // Named args
            $i = 0
            $len = count($expr->namedArgs)
            while ($i < $len) {
                var $na = $expr->namedArgs[$i]
                $this->checkExpr($na->value)
                $i = intval($i) + 1
            }
            return nil
        }
        if ($t == "PropertyAccess") {
            return $this->checkExpr($expr->object)
        }
        if ($t == "MethodCall") {
            $this->checkExpr($expr->object)
            var $i = 0
            var $len = count($expr->args)
            while ($i < $len) {
                $this->checkExpr($expr->args[$i])
                $i = intval($i) + 1
            }
            return nil
        }
        if ($t == "IndexExpr") {
            $this->checkExpr($expr->object)
            return $this->checkExpr($expr->index)
        }
        if ($t == "NewExpr") {
            var $i = 0
            var $len = count($expr->args)
            while ($i < $len) {
                $this->checkExpr($expr->args[$i])
                $i = intval($i) + 1
            }
            return nil
        }
        if ($t == "ClosureExpr") {
            if ($expr->body != nil) { $this->checkBlock($expr->body) }
            if ($expr->arrowExpr != nil) { $this->checkExpr($expr->arrowExpr) }
            return nil
        }
        if ($t == "AsyncExpr") {
            return $this->checkBlock($expr->body)
        }
        if ($t == "AwaitExpr") {
            return $this->checkExpr($expr->expr)
        }
        if ($t == "SendExpr") {
            $this->checkExpr($expr->ch)
            return $this->checkExpr($expr->value)
        }
        if ($t == "ReceiveExpr") {
            return $this->checkExpr($expr->ch)
        }
        if ($t == "ErrorExpr") {
            return $this->checkExpr($expr->message)
        }
        if ($t == "PrintExpr") {
            return $this->checkExpr($expr->arg)
        }
        if ($t == "ArrayLiteral") {
            var $i = 0
            var $len = count($expr->elements)
            while ($i < $len) {
                $this->checkExpr($expr->elements[$i])
                $i = intval($i) + 1
            }
            return nil
        }
        if ($t == "MapLiteral") {
            var $i = 0
            var $len = count($expr->keys)
            while ($i < $len) {
                $this->checkExpr($expr->keys[$i])
                $this->checkExpr($expr->values[$i])
                $i = intval($i) + 1
            }
            return nil
        }
        if ($t == "InterpolatedString") {
            var $i = 0
            var $len = count($expr->parts)
            while ($i < $len) {
                $this->checkExpr($expr->parts[$i])
                $i = intval($i) + 1
            }
            return nil
        }
        if ($t == "StringConcat") {
            $this->checkExpr($expr->left)
            return $this->checkExpr($expr->right)
        }
        if ($t == "StaticCall") {
            var $i = 0
            var $len = count($expr->args)
            while ($i < $len) {
                $this->checkExpr($expr->args[$i])
                $i = intval($i) + 1
            }
            return nil
        }

        return nil
    }

    // ========== Type Inference ==========

    public func stringToType($name) {
        if ($name == "int") { return "int" }
        if ($name == "float") { return "float" }
        if ($name == "float64") { return "float" }
        if ($name == "string") { return "string" }
        if ($name == "bool") { return "bool" }
        if ($name == "error") { return "error" }
        if ($name == "any") { return "any" }
        return "unknown"
    }

    public func inferType($expr) {
        if ($expr == nil) { return "any" }
        var $t = $expr->type
        if ($t == "IntLiteral") { return "int" }
        if ($t == "FloatLiteral") { return "float" }
        if ($t == "StringLiteral") { return "string" }
        if ($t == "InterpolatedString") { return "string" }
        if ($t == "EnumAccess") { return "string" }
        if ($t == "BoolLiteral") { return "bool" }
        if ($t == "NilLiteral") { return "nil" }
        if ($t == "ArrayLiteral") { return "array" }
        if ($t == "MapLiteral") { return "map" }
        if ($t == "ClosureExpr") { return "func" }
        if ($t == "ChannelExpr") { return "channel" }
        if ($t == "ErrorExpr") { return "error" }
        return "any"
    }

    // ========== DB-03: N+1 Detection ==========

    public func isDbQueryMethod($m) {
        if ($m == "get") { return true }
        if ($m == "first") { return true }
        if ($m == "find") { return true }
        if ($m == "qb_get") { return true }
        if ($m == "qb_first") { return true }
        if ($m == "all") { return true }
        return false
    }

    public func isDbRelationMethod($m) {
        if ($m == "with") { return true }
        if ($m == "qb_with") { return true }
        return false
    }

    public func exprName($expr) {
        if ($expr == nil) { return "_" }
        if ($expr->type == "DollarIdent") { return $expr->name }
        if ($expr->type == "Identifier") { return $expr->name }
        return "_"
    }

    public func checkN1InLoop($block, $loopLine) {
        if ($block == nil) { return nil }
        if ($block->type != "BlockStmt") { return nil }

        var $hasRelation = {}
        var $stmts = $block->statements
        var $i = 0
        var $len = count($stmts)

        while ($i < $len) {
            var $stmt = $stmts[$i]
            var $expr = nil
            
            if ($stmt->type == "ExpressionStmt") {
                $expr = $stmt->expr
            } else if ($stmt->type == "AssignStmt") {
                $expr = $stmt->value
            } else if ($stmt->type == "VarDecl") {
                $expr = $stmt->value
            }

            if ($expr != nil) {
                if ($expr->type == "MethodCall") {
                    var $recvName = $this->exprName($expr->object)

                    if ($this->isDbRelationMethod($expr->method)) {
                        $hasRelation[$recvName] = "yes"
                    } else if ($this->isDbQueryMethod($expr->method)) {
                        if ($hasRelation[$recvName] != "yes") {
                            var $w1 = "[N+1] DB query '" .. $expr->method
                            var $w2 = $w1 .. "()' inside a loop without eager loading — consider $"
                            var $w3 = $w2 .. $recvName
                            var $w4 = $w3 .. "->with() before the loop"
                            $this->addWarning($expr->line, $expr->col, $w4)
                        }
                    }
                }
            }

            $i = intval($i) + 1
        }
        return nil
    }
}
