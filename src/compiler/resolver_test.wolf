// ─── Test: symbol table nil-lookup ────────────────────────────────────────────

func test_resolver_lookup_miss() {
    var $src = "var $x = 1;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)
    var $table = $r->_symbolTable

    if ($r->lookupVar("nonexistent") != nil) {
        throw("test_resolver_lookup_miss: expected nil for unknown var")
    }
    if ($r->lookupFunc("nonexistent") != nil) {
        throw("test_resolver_lookup_miss: expected nil for unknown func")
    }
    if ($r->lookupClass("nonexistent") != nil) {
        throw("test_resolver_lookup_miss: expected nil for unknown class")
    }
    print("PASS: test_resolver_lookup_miss")
}

// ─── Test: Foreach Scoping ──────────────────────────────────────────────────

func test_resolver_foreach_scoping() {
    var $src = "foreach ([1, 2, 3] as $k => $v) { var $x = $v + $k; }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)

    var $errs = $r->errors
    var $errCount = 0
    var $i = 0
    while ($i < count($errs)) {
        var $errItem = $errs[$i]
        var $lvl = $errItem["level"]
        if ($lvl == "error") {
            $errCount = intval($errCount) + 1
            print("RESOLVE ERROR: " .. $errItem["message"])
        }
        $i = intval($i) + 1
    }

    if (intval($errCount) > 0) {
        print("❌ test_resolver_foreach_scoping - FAILED: test_resolver_foreach_scoping: expected no resolve errors")
        return nil
    }

    print("PASS: test_resolver_foreach_scoping")
    return nil
}

