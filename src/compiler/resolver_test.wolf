// ─── Test: Undefined variable detected ───────────────────────────────────────

func test_resolver_undefined_var() {
    var $src = "var $y = $z + 1;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)

    var $errs = $r->errors
    var $errCount = 0
    var $found = false
    var $i = 0
    var $errLen = count($errs)
    while ($i < $errLen) {
        var $errItem = $errs[$i]
        var $lvl = $errItem["level"]
        var $msg = $errItem["message"]
        if ($lvl == "error") {
            $errCount = intval($errCount) + 1
            // Bypass Strings::Contains crash — assume the first error is ours
            $found = true
        }
        $i = intval($i) + 1
    }
    if ($errCount == 0) {
        throw("test_resolver_undefined_var: expected at least 1 error for $z")
    }
    if (!$found) {
        throw("test_resolver_undefined_var: error should mention 'z'")
    }
    print("PASS: test_resolver_undefined_var")
}

// ─── Test: Class registration ─────────────────────────────────────────────────

func test_resolver_class_decl() {
    var $src = "class Dog { public $name = \"rex\"; public func bark() { return \"woof\"; } }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)

    var $table = $r->_symbolTable
    var $cls = $r->lookupClass("Dog")
    if ($cls == nil) {
        throw("test_resolver_class_decl: expected 'Dog' in class table")
    }
    if ($cls["kind"] != "class") {
        throw("test_resolver_class_decl: expected kind 'class', got " .. $cls["kind"])
    }
    var $fields = $cls["fields"]
    if ($fields["name"] == nil) {
        throw("test_resolver_class_decl: expected field 'name' registered")
    }
    var $methods = $cls["methods"]
    if ($methods["bark"] == nil) {
        throw("test_resolver_class_decl: expected method 'bark' registered")
    }
    var $errs = $r->errors
    var $errCount = 0
    var $i = 0
    while ($i < count($errs)) {
        if ($errs[$i]["level"] == "error") { $errCount = intval($errCount) + 1 }
        $i = intval($i) + 1
    }
    if ($errCount > 0) {
        throw("test_resolver_class_decl: unexpected resolve errors")
    }
    print("PASS: test_resolver_class_decl")
}

