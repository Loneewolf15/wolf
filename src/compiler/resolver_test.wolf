// resolver_test.wolf — Native Wolf Resolver Tests
//
// Architecture note: We build Lexer → Parser → Resolver inline in each test.
// This avoids the Wolf LLVM emitter limitation where function return values
// are typed as i64 (raw map pointer) and cannot be directly property-accessed
// via wolf_map_get without an inttoptr cast the emitter doesn't auto-insert.
// Keeping everything inline ensures $r is a properly-typed ptr alloca.

// ─── Test: Global variable declaration ───────────────────────────────────────

func test_resolver_var_decl() {
    var $src = "var $x = 42;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)

    var $table = $r->_symbolTable
    var $sym = $r->lookupVar("x")
    if ($sym == nil) {
        throw("test_resolver_var_decl: expected 'x' in symbol table, got nil")
    }
    if ($sym["kind"] != "var") {
        throw("test_resolver_var_decl: expected kind 'var', got " .. $sym["kind"])
    }
    var $errs = $r->errors
    var $errCount = 0
    var $i = 0
    while ($i < count($errs)) {
        if ($errs[$i]["level"] == "error") { $errCount = intval($errCount) + 1 }
        $i = intval($i) + 1
    }
    if ($errCount > 0) {
        throw("test_resolver_var_decl: unexpected resolve errors")
    }
    print("PASS: test_resolver_var_decl")
}

// ─── Test: Function hoisting ──────────────────────────────────────────────────

func test_resolver_func_hoist() {
    var $src = "var $msg = \"hi\"; func greet() { return \"hello\"; }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)

    var $table = $r->_symbolTable
    var $sym = $r->lookupFunc("greet")
    if ($sym == nil) {
        throw("test_resolver_func_hoist: 'greet' not in function table")
    }
    if ($sym["kind"] != "func") {
        throw("test_resolver_func_hoist: expected kind 'func', got " .. $sym["kind"])
    }
    var $errs = $r->errors
    var $errCount = 0
    var $i = 0
    while ($i < count($errs)) {
        if ($errs[$i]["level"] == "error") { $errCount = intval($errCount) + 1 }
        $i = intval($i) + 1
    }
    if ($errCount > 0) {
        throw("test_resolver_func_hoist: unexpected resolve errors")
    }
    print("PASS: test_resolver_func_hoist")
}

