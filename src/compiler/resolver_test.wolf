    while ($i < count($errs)) {
        if ($errs[$i]["level"] == "error") { $errCount = intval($errCount) + 1 }
        $i = intval($i) + 1
    }
    if ($errCount > 0) {
        throw("test_resolver_match_scoping: expected no errors")
    }
    print("PASS: test_resolver_match_scoping")
}

