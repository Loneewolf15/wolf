// ─── Test: func param count stored correctly ──────────────────────────────────

func test_resolver_func_param_count() {
    var $src = "func multiply($a, $b, $c) { return $a * $b * $c; }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)

    var $table = $r->_symbolTable
    var $sym = $r->lookupFunc("multiply")
    if ($sym == nil) {
        throw("test_resolver_func_param_count: 'multiply' not found")
    }
    if ($sym["paramCount"] != 3) {
        throw("test_resolver_func_param_count: expected 3, got " .. $sym["paramCount"])
    }
    print("PASS: test_resolver_func_param_count")
}

