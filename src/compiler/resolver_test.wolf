// ─── Test: new expression with unknown class ──────────────────────────────────

func test_resolver_new_unknown_class() {
    var $src = "var $x = new Ghost();"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    var $r = new Resolver()
    $r->Resolve($ast)

    var $errs = $r->errors
    var $errCount = 0
    var $found = false
    var $i = 0
    while ($i < count($errs)) {
        var $errItem2 = $errs[$i]
        var $lvl2 = $errItem2["level"]
        var $msg2 = $errItem2["message"]
        if ($lvl2 == "error") {
            $errCount = intval($errCount) + 1
            $found = true
        }
        $i = intval($i) + 1
    }
    if ($errCount == 0) {
        throw("test_resolver_new_unknown_class: expected error for unknown class 'Ghost'")
    }
    if (!$found) {
        throw("test_resolver_new_unknown_class: error should mention 'Ghost'")
    }
    print("PASS: test_resolver_new_unknown_class")
}

