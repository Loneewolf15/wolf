

enum TokenType {
    ILLEGAL,
    EOF,
    DOLLAR_IDENT,
    IDENT,
    STRING,
    INT,
    FLOAT,
    BOOL_TRUE,
    BOOL_FALSE,
    NIL,
    STRING_INTERP_START,
    STRING_INTERP_END,
    STRING_LITERAL_PART,
    FUNC,
    CLASS,
    NEW,
    IMPORT,
    IF,
    ELSE,
    ELSE_IF,
    FOR,
    FOREACH,
    WHILE,
    MATCH,
    RETURN,
    ASYNC,
    AWAIT,
    SPAWN,
    PARALLEL,
    CHANNEL,
    SEND,
    RECEIVE,
    TRY,
    CATCH,
    NAMESPACE,
    PRINT,
    VAR,
    PRIVATE,
    PUBLIC,
    PROTECTED,
    STATIC,
    AS,
    IN,
    ERROR,
    ENUM,
    INTERFACE,
    IMPLEMENTS,
    AT_ML,
    AT_MODEL,
    AT_SUPERVISE,
    AT_TRACE,
    PLUS,
    MINUS,
    STAR,
    SLASH,
    MODULO,
    INCREMENT,
    DECREMENT,
    EQUAL,
    NOT_EQUAL,
    LESS,
    LESS_EQUAL,
    GREATER,
    GREATER_EQUAL,
    AND,
    OR,
    NOT,
    ASSIGN,
    PLUS_ASSIGN,
    MINUS_ASSIGN,
    STAR_ASSIGN,
    SLASH_ASSIGN,
    ARROW,
    FAT_ARROW,
    DOT,
    DOT_DOT,
    QUESTION,
    COLON,
    DOUBLE_COLON,
    COMMA,
    SEMICOLON,
    HASH,
    AT,
    LPAREN,
    RPAREN,
    LBRACE,
    RBRACE,
    LBRACKET,
    RBRACKET,
    DOLLAR_LBRACE,
    INTERP_LBRACE
}

class Token {
    public $type = 0
    public $start = 0
    public $length = 0
    public $line = 0
    public $col = 0
}

func compiler_lexerhelper_get_keywords() {
    return {
        "func": TokenType::FUNC,
        "howl": TokenType::FUNC,
        "function": TokenType::FUNC,
        "class": TokenType::CLASS,
        "new": TokenType::NEW,
        "import": TokenType::IMPORT,
        "if": TokenType::IF,
        "else": TokenType::ELSE,
        "for": TokenType::FOR,
        "foreach": TokenType::FOREACH,
        "while": TokenType::WHILE,
        "match": TokenType::MATCH,
        "return": TokenType::RETURN,
        "async": TokenType::ASYNC,
        "await": TokenType::AWAIT,
        "spawn": TokenType::SPAWN,
        "parallel": TokenType::PARALLEL,
        "channel": TokenType::CHANNEL,
        "send": TokenType::SEND,
        "receive": TokenType::RECEIVE,
        "try": TokenType::TRY,
        "catch": TokenType::CATCH,
        "namespace": TokenType::NAMESPACE,
        "print": TokenType::PRINT,
        "var": TokenType::VAR,
        "private": TokenType::PRIVATE,
        "pri": TokenType::PRIVATE,
        "public": TokenType::PUBLIC,
        "pub": TokenType::PUBLIC,
        "protected": TokenType::PROTECTED,
        "pro": TokenType::PROTECTED,
        "static": TokenType::STATIC,
        "true": TokenType::BOOL_TRUE,
        "false": TokenType::BOOL_FALSE,
        "nil": TokenType::NIL,
        "as": TokenType::AS,
        "in": TokenType::IN,
        "enum": TokenType::ENUM,
        "interface": TokenType::INTERFACE,
        "implements": TokenType::IMPLEMENTS
    }
}
