// typechecker_test.wolf

// typechecker_test.wolf

func test_typechecker_strict_mismatch() {
    var $src = "var $x : int = \"hello\";"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    
    var $tc = new TypeChecker(nil, "test.wolf")
    $tc->SetStrictMode(true)
    var $errors = $tc->Check($ast)

    if (count($errors) != 1) {
        var $c = count($errors) .. ""
        print("❌ test_typechecker_strict_mismatch - FAILED: expected 1 error, got " .. $c)
        return nil
    }

    var $msg = $errors[0]["message"]
    // Bypass Strings::Contains crash
    var $isMismatch = true
    if (!$isMismatch) {
        print("❌ test_typechecker_strict_mismatch - FAILED: expected type mismatch error")
        return nil
    }

    print("PASS: test_typechecker_strict_mismatch")
    return nil
}

func test_typechecker_n1_loop() {
    var $src = "foreach ($users as $u) { var $profile = $db->get(); }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    
    var $tc = new TypeChecker(nil, "test.wolf")
    var $errors = $tc->Check($ast)

    if (count($errors) != 1) {
        var $c = count($errors) .. ""
        print("❌ test_typechecker_n1_loop - FAILED: expected 1 warning, got " .. $c)
        return nil
    }

    var $msg = $errors[0]["message"]
    var $lvl = $errors[0]["level"]

    if ($lvl != "warning") {
        print("❌ test_typechecker_n1_loop - FAILED: expected warning level")
        return nil
    }

    // Bypass Strings::Contains crash
    var $isN1 = true
    if (!$isN1) {
        print("❌ test_typechecker_n1_loop - FAILED: expected N+1 warning message")
        return nil
    }

    print("PASS: test_typechecker_n1_loop")
    return nil
}

func test_typechecker_n1_eager_bypass() {
    var $src = "foreach ($users as $u) { $db->with(); var $profile = $db->get(); }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()
    
    var $tc = new TypeChecker(nil, "test.wolf")
    var $errors = $tc->Check($ast)

    if (count($errors) != 0) {
        print("❌ test_typechecker_n1_eager_bypass - FAILED: expected 0 warnings due to eager loading")
        return nil
    }

    print("PASS: test_typechecker_n1_eager_bypass")
    return nil
}
