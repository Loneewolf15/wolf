    public $keys = []
    public $values = []

    public func __construct($keys, $values) {
        $this->type = "MapLiteral"
        $this->keys = $keys
        $this->values = $values
    }
}

class BinaryExpr extends ASTNode {
    public $left = nil
    public $op = ""
    public $right = nil

    public func __construct($left, $op, $right) {
        $this->type = "BinaryExpr"
        $this->left = $left
        $this->op = $op
        $this->right = $right
    }
}

class UnaryExpr extends ASTNode {
    public $op = ""
    public $operand = nil

    public func __construct($op, $operand) {
        $this->type = "UnaryExpr"
        $this->op = $op
        $this->operand = $operand
    }
}

class PostfixExpr extends ASTNode {
    public $operand = nil
    public $op = ""

    public func __construct($operand, $op) {
        $this->type = "PostfixExpr"
        $this->operand = $operand
        $this->op = $op
    }
}

class CallExpr extends ASTNode {
    public $callee = nil
    public $args = []
