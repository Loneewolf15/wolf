    public func __construct($tryBody, $catchVar, $catchBody) {
        $this->type = "TryCatchStmt"
        $this->tryBody = $tryBody
        $this->catchVar = $catchVar
        $this->catchBody = $catchBody
    }
}

class NamespaceDecl extends ASTNode {
