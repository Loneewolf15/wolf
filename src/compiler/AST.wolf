    public func __construct($name, $value) {
        $this->type = "NamedArg"
        $this->name = $name
        $this->value = $value
    }
}

class PropertyAccess extends ASTNode {
    public $object = nil
    public $property = ""

    public func __construct($object, $property) {
        $this->type = "PropertyAccess"
        $this->object = $object
        $this->property = $property
