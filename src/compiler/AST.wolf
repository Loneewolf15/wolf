// AST.wolf
// Defines the Abstract Syntax Tree node classes for the Wolf compiler.

class ASTNode {
    public $type = "ASTNode"
    public $line = 0
    public $col = 0
    public $startLine = 0
    public $startCol = 0
    
    public func __construct() {}
}

class Program extends ASTNode {
    public $statements = [] // Array of Statement nodes

    public func __construct() {
        $this->type = "Program"
    }
}

// ---------- Statements ----------

class ImportStmt extends ASTNode {
    public $path = ""
    public $alias = ""

    public func constructor() {
        $this->type = "ImportStmt"
    }
}

class ExpressionStmt extends ASTNode {
    public $expr = nil

    public func __construct($expr) {
        $this->type = "ExpressionStmt"
        $this->expr = $expr
    }
}

class VarDecl extends ASTNode {
    public $name = ""
    public $typeName = ""
    public $value = nil

    public func __construct($name, $typeName, $value) {
        $this->type = "VarDecl"
        $this->name = $name
        $this->typeName = $typeName
        $this->value = $value
    }
}

class AssignStmt extends ASTNode {
    public $target = nil
    public $op = ""
    public $value = nil

    public func __construct($target, $op, $value) {
        $this->type = "AssignStmt"
        $this->target = $target
        $this->op = $op
        $this->value = $value
    }
}

class ReturnStmt extends ASTNode {
    public $values = []

    public func __construct($values) {
        $this->type = "ReturnStmt"
        $this->values = $values
    }
}

class IfStmt extends ASTNode {
    public $condition = nil
    public $body = nil
    public $elseIfs = []
    public $elseBody = nil

    public func __construct($condition, $body) {
        $this->type = "IfStmt"
        $this->condition = $condition
        $this->body = $body
    }
}

class ElseIfClause extends ASTNode {
    public $condition = nil
    public $body = nil

    public func __construct($condition, $body) {
        $this->type = "ElseIfClause"
        $this->condition = $condition
        $this->body = $body
    }
}

class ForStmt extends ASTNode {
    public $init = nil
    public $condition = nil
    public $update = nil
    public $body = nil

    public func __construct($init, $condition, $update, $body) {
        $this->type = "ForStmt"
        $this->init = $init
        $this->condition = $condition
        $this->update = $update
        $this->body = $body
    }
}

class ForeachStmt extends ASTNode {
    public $iterable = nil
    public $valueVar = ""
    public $keyVar = ""
    public $body = nil

    public func __construct($iterable, $valueVar, $keyVar, $body) {
        $this->type = "ForeachStmt"
        $this->iterable = $iterable
        $this->valueVar = $valueVar
        $this->keyVar = $keyVar
        $this->body = $body
    }
}

class WhileStmt extends ASTNode {
    public $condition = nil
    public $body = nil

    public func __construct($condition, $body) {
        $this->type = "WhileStmt"
        $this->condition = $condition
        $this->body = $body
    }
}

class MatchStmt extends ASTNode {
    public $subject = nil
    public $arms = []

    public func __construct($subject, $arms) {
        $this->type = "MatchStmt"
        $this->subject = $subject
        $this->arms = $arms
    }
}

class MatchArm extends ASTNode {
    public $pattern = nil
    public $body = []

    public func __construct($pattern, $body) {
        $this->type = "MatchArm"
        $this->pattern = $pattern
        $this->body = $body
    }
}

class BlockStmt extends ASTNode {
    public $statements = []

    public func __construct($statements) {
        $this->type = "BlockStmt"
        $this->statements = $statements
    }
}

class FuncDecl extends ASTNode {
    public $name = ""
    public $params = []
    public $returnType = nil
    public $typeParams = []
    public $body = nil
    public $arrowExpr = nil

    public func __construct($name) {
        $this->type = "FuncDecl"
        $this->name = $name
    }
}

class Param extends ASTNode {
    public $name = ""
    public $typeName = ""
    public $defaultVal = nil

    public func __construct($name, $typeName, $defaultVal) {
        $this->type = "Param"
        $this->name = $name
        $this->typeName = $typeName
        $this->defaultVal = $defaultVal
    }
}

class ReturnTypeSpec extends ASTNode {
    public $types = []

    public func __construct($types) {
        $this->type = "ReturnTypeSpec"
        $this->types = $types
    }
}

class ClassDecl extends ASTNode {
    public $name = ""
    public $extendsName = ""
    public $typeParams = []
    public $implementsNames = []
    public $properties = []
    public $methods = []

    public func __construct($name) {
        $this->type = "ClassDecl"
        $this->name = $name
    }
}

class InterfaceDecl extends ASTNode {
    public $name = ""
    public $methods = []

    public func __construct($name) {
        $this->type = "InterfaceDecl"
        $this->name = $name
    }
}

class InterfaceMethod extends ASTNode {
    public $name = ""
    public $params = []
    public $returnType = nil

    public func __construct($name) {
        $this->type = "InterfaceMethod"
        $this->name = $name
    }
}

class EnumDecl extends ASTNode {
    public $name = ""
    public $variants = []

    public func __construct($name) {
        $this->type = "EnumDecl"
        $this->name = $name
    }
}

class PropertyDecl extends ASTNode {
    public $name = ""
    public $typeName = ""
    public $defaultVal = nil
    public $visibility = ""

    public func __construct($name, $typeName, $defaultVal, $visibility) {
        $this->type = "PropertyDecl"
        $this->name = $name
        $this->typeName = $typeName
        $this->defaultVal = $defaultVal
        $this->visibility = $visibility
    }
}

class TryCatchStmt extends ASTNode {
    public $tryBody = nil
    public $catchVar = ""
