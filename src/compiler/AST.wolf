class MLBlockStmt extends ASTNode {
    public $inVars = []
    public $outVars = []
    public $modelName = nil
    public $isAsync = false
    public $bodyStr = ""

    public func __construct() {
        $this->type = "MLBlockStmt"
    }
}

class SuperviseBlockStmt extends ASTNode {
    public $strategy = ""
    public $restart = ""
    public $max = 0
    public $body = nil

    public func __construct($strategy, $restart, $max, $body) {
        $this->type = "SuperviseBlockStmt"
        $this->strategy = $strategy
        $this->restart = $restart
        $this->max = $max
        $this->body = $body
    }
}

