    public $value = nil

    public func __construct($names, $value) {
        $this->type = "DestructureAssign"
        $this->names = $names
        $this->value = $value
    }
}

// ---------- Expressions ----------

class DollarIdent extends ASTNode {
    public $name = ""

    public func __construct($name) {
        $this->type = "DollarIdent"
        $this->name = $name
    }
}

class Identifier extends ASTNode {
    public $name = ""

    public func __construct($name) {
        $this->type = "Identifier"
        $this->name = $name
    }
}

class IntLiteral extends ASTNode {
    public $value = ""

    public func __construct($value) {
        $this->type = "IntLiteral"
        $this->value = $value
    }
}

class FloatLiteral extends ASTNode {
    public $value = ""

    public func __construct($value) {
        $this->type = "FloatLiteral"
        $this->value = $value
    }
}

class StringLiteral extends ASTNode {
    public $value = ""

    public func __construct($value) {
        $this->type = "StringLiteral"
        $this->value = $value
    }
}

class InterpolatedString extends ASTNode {
    public $parts = []

    public func __construct($parts) {
        $this->type = "InterpolatedString"
        $this->parts = $parts
    }
}

class BoolLiteral extends ASTNode {
    public $value = false

    public func __construct($value) {
        $this->type = "BoolLiteral"
        $this->value = $value
    }
}

class NilLiteral extends ASTNode {
    public func __construct() {
        $this->type = "NilLiteral"
    }
}

class Wildcard extends ASTNode {
    public func __construct() {
        $this->type = "Wildcard"
    }
}

class ArrayLiteral extends ASTNode {
    public $elements = []

    public func __construct($elements) {
        $this->type = "ArrayLiteral"
        $this->elements = $elements
