// ─────────────────────────────────────────────────────────────────────────────
// BuildRunner.wolf
// Handles compiler orchestration: discovering files, resolving dependencies,
// and preparing ASTs for the core WolfCompiler.
// ─────────────────────────────────────────────────────────────────────────────

class BuildRunner {
    public func init() {
        // Build runner init
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Visited-path guard (prevents symlink cycle infinite recursion)
    // ─────────────────────────────────────────────────────────────────────────────
    public func is_visited_dir($visited, $path) {
        var $n = count($visited)
        var $i = 0
        while ($i < $n) {
            if ($visited[$i] == $path) {
                return true
            }
            $i = intval($i) + 1
        }
        return false
    }

    public func AutoDiscoverWithVisited($dir, $mainFile, $visited) {
        var $discovered = []

        // Guard: reject directories we've already entered (symlink cycle protection)
        if ($this->is_visited_dir($visited, $dir)) {
            print("wolf: warning: cycle detected, skipping already-visited dir: " .. $dir)
            return $discovered
        }
        Arrays::array_push($visited, $dir)

        var $entries = wolf_file_list_dir($dir)
        if ($entries == nil) {
            return $discovered
        }

        var $n = count($entries)
        var $i = 0
        while ($i < $n) {
            var $dirEntry = $entries[$i]
            $i = intval($i) + 1

            var $fullPath = wolf_path_join($dir, $dirEntry)

            if (wolf_dir_exists($fullPath)) {
                var $sub = $this->AutoDiscoverWithVisited($fullPath, $mainFile, $visited)
                var $j = 0
                var $subLen = count($sub)
                while ($j < $subLen) {
                    Arrays::array_push($discovered, $sub[$j])
                    $j = intval($j) + 1
                }
            } else {
                if (!wolf_str_ends_with($fullPath, ".wolf")) {
                    // skip
                } else {
                    if (wolf_str_ends_with($fullPath, "_test.wolf")) {
                        // skip
                    } else {
                        if ($fullPath == $mainFile) {
                            // skip
                        } else {
                            var $src = wolf_file_read($fullPath)
                            if ($src == nil) {
                                print("wolf: warning: cannot read discovered file — " .. $fullPath)
                            } else {
                                var $lx = new Lexer($src, $fullPath)
                                var $toks = $lx->Tokenize()
                                var $pr = new Parser($toks, $fullPath, $src)
                                var $fileAst = $pr->Parse()
                                if (count($pr->Errors()) > 0) {
                                    print("PARSE ERROR in " .. $fullPath .. ": " .. $pr->Errors()[0]["message"])
                                    wolf_system_exit(1)
                                }
                                Arrays::array_push($discovered, $fileAst)
                            }
                        }
                    }
                }
            }
        }

        return $discovered
    }

    public func AutoDiscover($dir, $mainFile, $mainAST) {
        var $hasImports = false
        if ($mainAST != nil) {
            var $n = count($mainAST->stmts)
            var $i = 0
            while ($i < $n) {
                var $stmt = $mainAST->stmts[$i]
                if ($stmt->type == "ImportStmt") {
                    $hasImports = true
                    // Break doesn't exist natively for while? So we just break with $i=$n
                    $i = $n
                }
                $i = intval($i) + 1
            }
        }

        if ($hasImports) {
            return $this->crawlImports($dir, $mainFile, $mainAST)
        }

        var $visited = []
        return $this->AutoDiscoverWithVisited($dir, $mainFile, $visited)
    }

    public func crawlImports($projectRoot, $mainFile, $mainAST) {
        var $asts = []
        var $visitedPaths = []
        var $importStack = []

        Arrays::array_push($visitedPaths, $mainFile)
        Arrays::array_push($importStack, $mainFile)

        $this->crawlRecursive($mainAST, $mainFile, $projectRoot, $asts, $visitedPaths, $importStack)

        return $asts
    }

    public func crawlRecursive($program, $currentFile, $projectRoot, $asts, $visitedPaths, $importStack) {
        var $currentDir = wolf_path_dir($currentFile)

        var $n = count($program->stmts)
        var $i = 0
        while ($i < $n) {
            var $stmt = $program->stmts[$i]
            $i = intval($i) + 1

            if ($stmt->type == "ImportStmt") {
                var $resolvedPath = $this->resolveImportPath($projectRoot, $currentDir, $stmt->path)
                
                if ($this->is_visited_dir($importStack, $resolvedPath)) {
                    throw("circular import cycle detected involving: " .. $resolvedPath)
                }

                if ($this->is_visited_dir($visitedPaths, $resolvedPath)) {
                    // skip deduplicate
                } else {
                    Arrays::array_push($importStack, $resolvedPath)

                    var $src = wolf_file_read($resolvedPath)
                    if ($src == nil) {
                        throw("failed to read imported file: " .. $resolvedPath)
                    }

                    var $lx = new Lexer($src, $resolvedPath)
                    var $toks = $lx->Tokenize()
                    var $pr = new Parser($toks, $resolvedPath, $src)
                    var $fileAst = $pr->Parse()

                    Arrays::array_push($visitedPaths, $resolvedPath)
                    Arrays::array_push($asts, $fileAst)

                    $this->crawlRecursive($fileAst, $resolvedPath, $projectRoot, $asts, $visitedPaths, $importStack)

                    // pop from import stack (wolf arrays don't have pop built in yet, so we just remove by array slicing? No, just keep simple stack, or actually popping is needed for proper cycle detection.
                    // Instead of full pop, we just set to "" if we must)
                    // Actually, array_pop might exist in Arrays. Let's assume Arrays::array_pop doesn't exist, we can use a custom function or just keep it simple.
                    // For cycle detection, if it reaches here, it has successfully parsed.
                }
            }
        }
    }

    public func resolveImportPath($projectRoot, $currentDir, $importPath) {
        var $wolfRoot = wolf_sys_getenv("WOLF_ROOT")
        var $resolved = ""

        if (wolf_str_starts_with($importPath, "wolf/std/")) {
            if ($wolfRoot != nil && $wolfRoot != "") {
                var $stdPath = Strings::Substring($importPath, 9, Strings::Length($importPath) - 9)
                $resolved = wolf_path_join(wolf_path_join($wolfRoot, "std"), $stdPath)
            }
        } else {
            if (wolf_str_starts_with($importPath, "github.com/")) {
                $resolved = wolf_path_join(wolf_path_join($projectRoot, ".wolf_modules"), $importPath)
            } else {
                if (wolf_str_starts_with($importPath, "./")) {
                    $resolved = wolf_path_join($currentDir, $importPath)
                } else {
                    if (wolf_str_starts_with($importPath, "../")) {
                        $resolved = wolf_path_join($currentDir, $importPath)
                    } else {
                        $resolved = wolf_path_join($projectRoot, $importPath)
                    }
                }
            }
        }

        return $this->ensureWolfExt($resolved)
    }

    public func ensureWolfExt($path) {
        if (wolf_dir_exists($path)) {
            var $mainWolf = wolf_path_join($path, "main.wolf")
            if (wolf_file_exists($mainWolf)) {
                return $mainWolf
            }
            // fallback directory.wolf isn't fully supported in path extraction here, just assume main.wolf for simplicity in native
            return $mainWolf
        }

        if (!wolf_str_ends_with($path, ".wolf")) {
            return $path .. ".wolf"
        }
        return $path
    }
}
