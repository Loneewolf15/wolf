// parser_test.wolf — Comprehensive Pratt Parser Tests

func test_parser_basic() {
    var $src = "var $x = 10;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_basic failed: parse errors found")
    }
    if ($ast->type != "Program") {
        throw("test_parser_basic failed: expected Program AST")
    }
    if (count($ast->statements) != 1) {
        throw("test_parser_basic failed: expected 1 statement, got " .. count($ast->statements))
    }
    var $stmt = $ast->statements[0]
    if ($stmt->type != "VarDecl") {
        throw("test_parser_basic failed: expected VarDecl, got " .. $stmt->type)
    }
    if ($stmt->name != "x") {
        throw("test_parser_basic failed: expected name 'x', got " .. $stmt->name)
    }
    print("PASS: test_parser_basic")
}

func test_parser_binary_expr() {
    var $src = "var $result = 1 + 2 * 3;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_binary_expr failed: parse errors found")
    }
    var $stmt = $ast->statements[0]
    if ($stmt->type != "VarDecl") {
        throw("test_parser_binary_expr failed: expected VarDecl")
    }
    // RHS should be BinaryExpr (1 + (2 * 3)) — + at top, * nested on right
    var $val = $stmt->value
    if ($val->type != "BinaryExpr") {
        throw("test_parser_binary_expr failed: expected BinaryExpr at root, got " .. $val->type)
    }
    if ($val->op != "+") {
        throw("test_parser_binary_expr failed: expected '+' as root op, got " .. $val->op)
    }
    var $right = $val->right
    if ($right->type != "BinaryExpr") {
        throw("test_parser_binary_expr failed: expected nested BinaryExpr on right")
    }
    if ($right->op != "*") {
        throw("test_parser_binary_expr failed: expected '*' in nested expr, got " .. $right->op)
    }
    print("PASS: test_parser_binary_expr")
}

func test_parser_precedence_comparison() {
    // a == b && c != d  →  (a == b) && (c != d)
    var $src = "var $x = $a == $b && $c != $d;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_precedence_comparison failed: " .. count($parser->Errors()) .. " errors")
    }
    var $val = $ast->statements[0]->value
    if ($val->type != "BinaryExpr") {
        throw("test_parser_precedence_comparison failed: expected BinaryExpr at root")
    }
    if ($val->op != "&&") {
        throw("test_parser_precedence_comparison failed: expected '&&' at root, got " .. $val->op)
    }
    if ($val->left->op != "==") {
        throw("test_parser_precedence_comparison failed: expected '==' on left")
    }
    if ($val->right->op != "!=") {
        throw("test_parser_precedence_comparison failed: expected '!=' on right")
    }
    print("PASS: test_parser_precedence_comparison")
}

func test_parser_unary_expr() {
    var $src = "var $x = !$flag;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_unary_expr failed: errors found")
    }
    var $val = $ast->statements[0]->value
    if ($val->type != "UnaryExpr") {
        throw("test_parser_unary_expr failed: expected UnaryExpr, got " .. $val->type)
    }
    if ($val->op != "!") {
        throw("test_parser_unary_expr failed: expected '!' op, got " .. $val->op)
    }
    print("PASS: test_parser_unary_expr")
}

func test_parser_string_concat() {
    var $src = "var $s = \"hello\" .. \" \" .. \"world\";"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_string_concat failed: errors found")
    }
    var $val = $ast->statements[0]->value
    if ($val->type != "StringConcat") {
        throw("test_parser_string_concat failed: expected StringConcat at root, got " .. $val->type)
    }
    // left should also be StringConcat ("hello" .. " ")
    if ($val->left->type != "StringConcat") {
        throw("test_parser_string_concat failed: expected nested StringConcat on left")
    }
    print("PASS: test_parser_string_concat")
}

func test_parser_method_call() {
    var $src = "var $n = $obj->getName();"
    var $lexer = new Lexer($src, "test.wolf")
