func test_parser_if_stmt() {
    var $src = "if ($x > 0) { var $y = 1; } else { var $y = 0; }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_if_stmt failed: errors found")
    }
    var $stmt = $ast->statements[0]
    if ($stmt->type != "IfStmt") {
        throw("test_parser_if_stmt failed: expected IfStmt, got " .. $stmt->type)
    }
    if ($stmt->condition->type != "BinaryExpr") {
        throw("test_parser_if_stmt failed: expected BinaryExpr condition")
    }
    if ($stmt->condition->op != ">") {
        throw("test_parser_if_stmt failed: expected '>' condition op")
    }
    if ($stmt->elseBody == nil) {
        throw("test_parser_if_stmt failed: expected else body to be parsed")
    }
    print("PASS: test_parser_if_stmt")
}

func test_parser_if_elseif_else() {
    var $src = "if ($x == 1) { var $a = 1; } else if ($x == 2) { var $a = 2; } else { var $a = 0; }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_if_elseif_else failed: errors found")
    }
    var $stmt = $ast->statements[0]
    if ($stmt->type != "IfStmt") {
        throw("test_parser_if_elseif_else failed: expected IfStmt")
    }
    if (count($stmt->elseIfs) != 1) {
        throw("test_parser_if_elseif_else failed: expected 1 elseif, got " .. count($stmt->elseIfs))
    }
    if ($stmt->elseBody == nil) {
        throw("test_parser_if_elseif_else failed: expected else body")
    }
    print("PASS: test_parser_if_elseif_else")
}

func test_parser_for_stmt() {
    var $src = "for ($i = 0; $i < 10; $i++) { var $x = $i; }"
    var $lexer = new Lexer($src, "test.wolf")
