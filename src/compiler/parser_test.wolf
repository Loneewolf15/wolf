func test_parser_class_decl() {
    var $src = "class Dog { public $name = \"rex\"; public func bark() { print(\"woof\"); } }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_class_decl failed: " .. count($parser->Errors()) .. " errors")
    }
    var $stmt = $ast->statements[0]
    if ($stmt->type != "ClassDecl") {
        throw("test_parser_class_decl failed: expected ClassDecl, got " .. $stmt->type)
    }
    if ($stmt->name != "Dog") {
        throw("test_parser_class_decl failed: expected name 'Dog', got " .. $stmt->name)
    }
    if (count($stmt->properties) != 1) {
        throw("test_parser_class_decl failed: expected 1 property, got " .. count($stmt->properties))
    }
    if (count($stmt->methods) != 1) {
        throw("test_parser_class_decl failed: expected 1 method, got " .. count($stmt->methods))
    }
    if ($stmt->methods[0]->name != "bark") {
        throw("test_parser_class_decl failed: expected method 'bark'")
    }
    print("PASS: test_parser_class_decl")
}

func test_parser_return_stmt() {
    var $src = "func add($a, $b) { return $a + $b; }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_return_stmt failed: errors found")
    }
    var $fn = $ast->statements[0]
    if ($fn->type != "FuncDecl") {
        throw("test_parser_return_stmt failed: expected FuncDecl, got " .. $fn->type)
    }
    if (count($fn->params) != 2) {
        throw("test_parser_return_stmt failed: expected 2 params, got " .. count($fn->params))
    }
    var $body = $fn->body
    if ($body->type != "BlockStmt") {
        throw("test_parser_return_stmt failed: expected BlockStmt body")
    }
    var $ret = $body->statements[0]
    if ($ret->type != "ReturnStmt") {
        throw("test_parser_return_stmt failed: expected ReturnStmt, got " .. $ret->type)
    }
    if (count($ret->values) != 1) {
        throw("test_parser_return_stmt failed: expected 1 return value")
    }
    if ($ret->values[0]->op != "+") {
        throw("test_parser_return_stmt failed: expected '+' in return expression")
    }
    print("PASS: test_parser_return_stmt")
}

func test_parser_grouped_expr() {
    // (1 + 2) * 3  →  * at root, + nested on left
    var $src = "var $v = (1 + 2) * 3;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_grouped_expr failed: errors found")
    }
    var $val = $ast->statements[0]->value
    if ($val->type != "BinaryExpr") {
        throw("test_parser_grouped_expr failed: expected BinaryExpr")
    }
    if ($val->op != "*") {
        throw("test_parser_grouped_expr failed: expected '*' at root due to grouping, got " .. $val->op)
    }
    if ($val->left->op != "+") {
        throw("test_parser_grouped_expr failed: expected '+' on left from grouping")
    }
    print("PASS: test_parser_grouped_expr")
}

// ─── Test: Foreach Statement ──────────────────────────────────────────────────

func test_parser_foreach_stmt() {
    var $src = "foreach ($arr as $k => $v) { print($v); }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if ($parser->Errors() != nil) {
        if (count($parser->Errors()) > 0) {
            print("❌ test_parser_foreach_stmt - FAILED: expected no errors")
            return nil
        }
    }

    var $stmt = $ast->statements[0]
    if ($stmt->type != "ForeachStmt") {
        print("❌ test_parser_foreach_stmt - FAILED: expected ForeachStmt, got " .. $stmt->type)
        return nil
    }

    if ($stmt->iterable->type != "DollarIdent") {
        print("❌ test_parser_foreach_stmt - FAILED: expected DollarIdent iterable")
        return nil
    }

    if ($stmt->keyVar != "k") {
        print("❌ test_parser_foreach_stmt - FAILED: expected keyVar 'k', got " .. $stmt->keyVar)
        return nil
    }

    if ($stmt->valueVar != "v") {
        print("❌ test_parser_foreach_stmt - FAILED: expected valueVar 'v', got " .. $stmt->valueVar)
        return nil
    }

    print("PASS: test_parser_foreach_stmt")
    return nil
}

func test_parser_closure_arrow() {
    var $src = "var $add = func($a, $b) => $a + $b;"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_closure_arrow failed: expected no errors")
    }

    var $stmt = $ast->statements[0]
    var $closure = $stmt->value
    
    if ($closure->type != "ClosureExpr") {
        throw("test_parser_closure_arrow failed: expected ClosureExpr")
    }
    
    if (count($closure->params) != 2) {
        throw("test_parser_closure_arrow failed: expected 2 params")
    }
    
    if ($closure->arrowExpr->type != "BinaryExpr") {
        throw("test_parser_closure_arrow failed: expected BinaryExpr in arrow")
    }
    
    print("PASS: test_parser_closure_arrow")
    return nil
}

func test_parser_closure_block() {
    var $src = "var $print = func($msg) { print($msg); };"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_closure_block failed: expected no errors")
    }

    var $stmt = $ast->statements[0]
    var $closure = $stmt->value
    
    if ($closure->type != "ClosureExpr") {
        throw("test_parser_closure_block failed: expected ClosureExpr")
    }
    
    if ($closure->body->type != "BlockStmt") {
        throw("test_parser_closure_block failed: expected BlockStmt body")
    }
    
    print("PASS: test_parser_closure_block")
    return nil
}

func test_parser_match_stmt() {
    var $src = "match $x { 1 => print(\"1\"); _ => { print(\"other\"); } }"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_match_stmt failed: expected no errors")
    }

    var $stmt = $ast->statements[0]
    if ($stmt->type != "MatchStmt") {
        throw("test_parser_match_stmt failed: expected MatchStmt")
    }

    if (count($stmt->arms) != 2) {
        throw("test_parser_match_stmt failed: expected 2 arms")
    }

    var $arm1 = $stmt->arms[0]
    if ($arm1->pattern->type != "IntLiteral") {
        throw("test_parser_match_stmt failed: expected IntLiteral pattern in arm 1")
    }

    var $arm2 = $stmt->arms[1]
    if ($arm2->pattern->type != "Wildcard") {
        throw("test_parser_match_stmt failed: expected Wildcard pattern in arm 2")
    }

    print("PASS: test_parser_match_stmt")
    return nil
}

