    if (count($parser->Errors()) > 0) {
        throw("test_parser_for_stmt failed: " .. count($parser->Errors()) .. " errors")
    }
    var $stmt = $ast->statements[0]
    if ($stmt->type != "ForStmt") {
        throw("test_parser_for_stmt failed: expected ForStmt, got " .. $stmt->type)
    }
    if ($stmt->condition == nil) {
        throw("test_parser_for_stmt failed: expected non-nil condition")
    }
    if ($stmt->body == nil) {
        throw("test_parser_for_stmt failed: expected non-nil body")
    }
    print("PASS: test_parser_for_stmt")
}

