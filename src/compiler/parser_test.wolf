    if (count($parser->Errors()) > 0) {
        throw("test_parser_method_call failed: errors found")
    }
    var $val = $ast->statements[0]->value
    if ($val->type != "MethodCall") {
        throw("test_parser_method_call failed: expected MethodCall, got " .. $val->type)
    }
    if ($val->method != "getName") {
        throw("test_parser_method_call failed: expected method 'getName', got " .. $val->method)
    }
    print("PASS: test_parser_method_call")
}

func test_parser_chained_method_call() {
    var $src = "var $v = $arr->filter($fn)->count();"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_chained_method_call failed: errors found")
    }
    var $val = $ast->statements[0]->value
    if ($val->type != "MethodCall") {
        throw("test_parser_chained_method_call failed: outer should be MethodCall, got " .. $val->type)
    }
    if ($val->method != "count") {
        throw("test_parser_chained_method_call failed: outer method should be 'count'")
    }
    if ($val->object->type != "MethodCall") {
        throw("test_parser_chained_method_call failed: inner should be MethodCall")
    }
    if ($val->object->method != "filter") {
        throw("test_parser_chained_method_call failed: inner method should be 'filter'")
    }
    print("PASS: test_parser_chained_method_call")
}

func test_parser_static_call() {
    var $src = "var $sub = Strings::Substring($s, 0, 5);"
    var $lexer = new Lexer($src, "test.wolf")
    var $tokens = $lexer->Tokenize()
    var $parser = new Parser($tokens, "test.wolf", $src)
    var $ast = $parser->Parse()

    if (count($parser->Errors()) > 0) {
        throw("test_parser_static_call failed: errors found")
    }
    var $val = $ast->statements[0]->value
    if ($val->type != "StaticCall") {
        throw("test_parser_static_call failed: expected StaticCall, got " .. $val->type)
    }
    if ($val->className != "Strings") {
        throw("test_parser_static_call failed: expected className 'Strings', got " .. $val->className)
    }
    if ($val->method != "Substring") {
        throw("test_parser_static_call failed: expected method 'Substring', got " .. $val->method)
    }
    if (count($val->args) != 3) {
        throw("test_parser_static_call failed: expected 3 args, got " .. count($val->args))
    }
    print("PASS: test_parser_static_call")
}

