    if ($val->type != "NewExpr") {
        throw("test_parser_new_expr failed: expected NewExpr, got " .. $val->type)
    }
    if ($val->classExpr->name != "Parser") {
        throw("test_parser_new_expr failed: expected class 'Parser', got " .. $val->classExpr->name)
    }
    if (count($val->args) != 3) {
        throw("test_parser_new_expr failed: expected 3 args, got " .. count($val->args))
    }
    print("PASS: test_parser_new_expr")
}

