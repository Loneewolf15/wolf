// src/compiler/main.wolf
// Wolf Self-Hosted Compiler — Partial Self-Hosting Entry Point
// Phases 1-5 run natively in Wolf.
// Self-hosting milestone: Wolf compiler can analyze AND emit LLVM IR natively.
//
// --project <dir>  AutoDiscovery: scan <dir> recursively for .wolf files,
//                  lex+parse each, merge all ASTs into one program, then
//                  resolve + typecheck the merged whole in a single pass.
//                  This mirrors the Go bootstrap's AutoDiscover logic in
//                  internal/compiler/autodiscovery.go exactly.
//
// --dump-wir       Print the WolfIR (WIR) text representation to stdout
//                  (human-readable SSA-form IR, for debugging and verification).
//
// --emit-llvm      Lower WIR to LLVM IR text format (.ll) and print to stdout.
//                  Phase 6 of the native compilation pipeline (ADR-027).
//                  Pipe to a file: wolf-self <file.wolf> --emit-llvm > out.ll
//
// Hardening (Session 34):
//   - wolf_file_list_dir returns OS readdir order (non-deterministic).
//     We call sort($entries) after listing so discovery order is alphabetical,
//     matching Go's os.ReadDir sorted output for bootstrap parity.
//   - Visited-path tracking prevents infinite recursion on circular symlinks.
//   - Error bubbling: wolf_file_read failures emit a named warning, not silent skip.
//   - Non-.wolf artifact filtering confirmed in place (emitter, .go, .md all skipped).
//
// ABI note (why wolf_str_ends_with is safe here):
//   Both arguments at every call site are known-string (ptr):
//     - $fullPath is always a wolf_path_join result (ptr)
//     - ".wolf" / "_test.wolf" are string literals (ptr)
//   No type ambiguity at call sites. Return type i1 is unambiguous.
//   Contrast with the Strings::Contains crash: that was call-site argument
//   type ambiguity (integer-boxed ptr passed to strstr). Different root cause.

// ─────────────────────────────────────────────────────────────────────────────
// WolfCompiler
// ─────────────────────────────────────────────────────────────────────────────


class WolfCompiler {
    public $file = ""
    public $source = ""
    public $strict = false
    public $projectDir = ""
    public $dumpWIR = false
    public $emitLLVM = false

    public func __construct($file, $source, $strict, $projectDir, $dumpWIR, $emitLLVM) {
        $this->file       = $file
        $this->source     = $source
        $this->strict     = $strict
        $this->projectDir = $projectDir
        $this->dumpWIR    = $dumpWIR
        $this->emitLLVM   = $emitLLVM
    }

    // ─── Compile ───────────────────────────────────────────────────────────
    // Main compilation pipeline.
    // When $this->projectDir != "", Phase 2.5 auto-discovers companion files
    // and merges all their statements BEFORE main's statements (mirrors
    // compiler.go line 113: program.Statements = append(allDiscovered, program.Statements...))
    // so that class/func hoisting in the Resolver sees all declarations.

    public func Compile() {
        // Phase 1 — Lex
        var $lexer  = new Lexer($this->source, $this->file)
        var $tokens = $lexer->Tokenize()

        if (count($tokens) == 0) {
            throw("wolf: lex error — no tokens produced from " .. $this->file)
        }

        // Phase 2 — Parse
        var $parser = new Parser($tokens, $this->file, $this->source)
        var $ast    = $parser->Parse()

        if (count($parser->Errors()) > 0) {
            var $errs = $parser->Errors()
            var $i = 0
            while ($i < count($errs)) {
                var $e = $errs[$i]
                print("wolf: parse error: " .. $e["message"] .. " at line " .. $e["line"])
                $i = intval($i) + 1
            }
            throw("wolf: parse failed — " .. $this->file)
        }

        // Phase 2.5 — AutoDiscover via BuildRunner
        // Only runs when --project was passed.
        if ($this->projectDir != "") {
            if (wolf_dir_exists($this->projectDir)) {
                var $buildRunner = new BuildRunner()
                var $discoveredAsts = $buildRunner->AutoDiscover($this->projectDir, $this->file, $ast)
                var $discoveredCount = count($discoveredAsts)

                if ($discoveredCount > 0) {
                    // Flatten discovered statements into a prefix array
                    var $allDiscovered = []
                    var $di = 0
                    while ($di < $discoveredCount) {
                        var $dAst = $discoveredAsts[$di]
                        var $dStmts = $dAst->statements
                        var $si = 0
                        while ($si < count($dStmts)) {
                            Arrays::array_push($allDiscovered, $dStmts[$si])
                            $si = intval($si) + 1
                        }
                        $di = intval($di) + 1
                    }

                    // Prepend discovered statements before main AST statements.
                    // This is the critical merged-program pattern:
                    // program.Statements = append(allDiscovered, program.Statements...)
                    // Without this, Resolver->hoistTopLevel runs per-file and
                    // misses cross-file class declarations ("undefined class: Token").
                    var $merged = []
                    var $mi = 0
                    while ($mi < count($allDiscovered)) {
                        Arrays::array_push($merged, $allDiscovered[$mi])
                        $mi = intval($mi) + 1
                    }
                    var $ms = 0
                    while ($ms < count($ast->statements)) {
                        Arrays::array_push($merged, $ast->statements[$ms])
                        $ms = intval($ms) + 1
                    }
                    $ast->statements = $merged
                }
            } else {
                print("wolf: warning: --project dir not found: " .. $this->projectDir)
            }
        }

        // Phase 3 — Resolve (single pass over merged program)
        var $resolver = new Resolver()
        $resolver->Resolve($ast)

        if ($this->strict) {
            var $resolveErrs = $resolver->Errors()
            var $ri = 0
            while ($ri < count($resolveErrs)) {
                var $re = $resolveErrs[$ri]
                if ($re["level"] == "error") {
                    print("wolf: resolve error: " .. $re["message"])
                }
                $ri = intval($ri) + 1
            }
        }

        // Phase 4 — Typecheck (single pass over merged program)
        var $checker = new TypeChecker($resolver, $this->file)
        if ($this->strict) {
            $checker->SetStrictMode(true)
        }
        $checker->Check($ast)

        // Phase 5 — WIR Builder: lower AST to Wolf Intermediate Representation
        var $builder = new WIRBuilder()
        var $module = $builder->build($ast)

        if ($this->dumpWIR) {
            print($module->to_string())
        }

        // Phase 6 — LLVM IR Emission (ADR-027): lower WIR → LLVM text format (.ll)
        if ($this->emitLLVM) {
            var $llvmEmitter = new LLVMEmitter($module)
            var $llvmIR = $llvmEmitter->emit()
            print($llvmIR)
        }

        if (!$this->emitLLVM) {
            if (!$this->dumpWIR) {
                print("wolf: analysis complete — " .. $this->file)
                if ($this->projectDir != "") {
                    print("wolf: --project mode, dir: " .. $this->projectDir)
                }
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// CLI entry point
// Usage: wolf-self <file.wolf> [--strict] [--project <dir>] [--dump-wir] [--emit-llvm]
// ─────────────────────────────────────────────────────────────────────────────
func main() {
    var $argc = wolf_argc()

    if ($argc < 2) {
        print("usage: wolf-self <file.wolf> [--strict] [--project <dir>] [--dump-wir] [--emit-llvm]")
        wolf_system_exit(1)
    }

    var $file       = wolf_argv(1)
    var $strict     = false
    var $projectDir = ""
    var $dumpWIR    = false
    var $emitLLVM   = false

    // Parse remaining flags
    var $argi = 2
    while ($argi < $argc) {
        var $arg = wolf_argv($argi)
        if ($arg == "--strict") {
            $strict = true
        } else {
            if ($arg == "--project") {
                var $nextIdx = intval($argi) + 1
                if ($nextIdx < $argc) {
                    $projectDir = wolf_argv($nextIdx)
                    $argi = intval($argi) + 1
                } else {
                    print("wolf: --project requires a directory argument")
                    wolf_system_exit(1)
                }
            } else {
                if ($arg == "--dump-wir") {
                    $dumpWIR = true
                } else {
                    if ($arg == "--emit-llvm") {
                        $emitLLVM = true
                    }
                }
            }
        }
        $argi = intval($argi) + 1
    }

    var $source = wolf_file_read($file)

    if ($source == nil) {
        print("wolf: cannot read file — " .. $file)
        wolf_system_exit(1)
    }

    var $compiler = new WolfCompiler($file, $source, $strict, $projectDir, $dumpWIR, $emitLLVM)
    $compiler->Compile()
}
