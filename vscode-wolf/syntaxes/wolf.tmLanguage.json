{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wolf",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#annotations"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.wolf",
          "match": "//.*$"
        },
        {
          "name": "comment.block.wolf",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wolf",
          "match": "\\b(if|else|for|while|return|break|continue|match|case|default|try|catch|parallel|spawn)\\b"
        },
        {
          "name": "storage.type.wolf",
          "match": "\\b(func|class|interface|impl|var|const)\\b"
        },
        {
          "name": "storage.modifier.wolf",
          "match": "\\b(pub|pri|pro|protected)\\b"
        },
        {
          "name": "constant.language.wolf",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wolf",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wolf",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.wolf",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.wolf",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.wolf",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.wolf",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  },
  "scopeName": "source.wolf"
}
